    "Pornește înregistrarea pentru mașina configurată, cu permisiunea de localizare Întotdeauna.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording for the configured vehicle with Always location permission."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pornește înregistrarea pentru mașina configurată, cu permisiunea de localizare Întotdeauna."
          }
        }
      }
    },
    "Încheie sesiunea automată după două minute dacă mașina nu se reconectează.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End the automatic trip after two minutes unless the vehicle reconnects."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Încheie sesiunea automată după două minute dacă mașina nu se reconectează."
